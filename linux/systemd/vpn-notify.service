[Unit]
Description=WireGuard VPN connection notification

[Service]
Type=oneshot
ExecStart=/bin/bash -c 'nmcli -t -f NAME,DEVICE con show --active | grep -q "^WireGuard:" && notify-send -u normal -i /usr/share/icons/breeze-dark/devices/24/network-vpn.svg "VPN Active" "Connected to WireGuard" || true'
